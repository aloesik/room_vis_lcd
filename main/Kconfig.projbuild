menu "ESP32-S3-Touch-LCD-7 Configuration"
    menu "LVGL GPIO assignment"
        config LCD_VSYNC_GPIO
            int "VSYNC GPIO"
            default 3
            help
                GPIO pin number for VSYNC signal.
