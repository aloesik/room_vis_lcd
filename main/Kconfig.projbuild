    menu "Touch GPIO assignment"
    config I2C_MASTER_SCL
        int "SCL GPIO Num"
        default 9
        help
            GPIO pin number for I2C Master clock line.

    config I2C_MASTER_SDA
        int "SDA GPIO Num"
        default 8
        help
            GPIO pin number for I2C Master data line.
